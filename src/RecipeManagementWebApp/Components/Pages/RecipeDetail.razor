@page "/recipes/{Id:guid}"
@rendermode InteractiveServer
@using RecipeManagementWebApp.Domain
@using RecipeManagementWebApp.Services
@inject IRecipeService RecipeService
@inject ITagService TagService
@inject ICookLogService CookLogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(_recipe?.Title ?? "Recipe")</PageTitle>

@if (_notFound)
{
    <div class="py-4">
        <h1>Recipe not found</h1>
        <a href="/">Back to recipes</a>
    </div>
}
else if (_recipe is null)
{
    <p>Loading...</p>
}
else
{
    <div class="row">
        <div class="col-md-5">
            @if (_recipe.Photo is not null)
            {
                <img src="@_recipe.Photo.StoredAt" class="img-fluid rounded recipe-photo" alt="@_recipe.Title" />
            }
            else
            {
                <div class="recipe-photo recipe-placeholder d-flex align-items-center justify-content-center rounded">
                    <span>No Photo</span>
                </div>
            }
        </div>
        <div class="col-md-7">
            <div class="d-flex align-items-start gap-2">
                <h1 class="flex-grow-1">@_recipe.Title</h1>
                <button type="button"
                        class="btn btn-link fs-3 p-0 text-decoration-none @(_recipe.IsFavorite ? "text-warning" : "text-muted")"
                        title="@(_recipe.IsFavorite ? "Unfavourite" : "Favourite")"
                        aria-label="@(_recipe.IsFavorite ? "Remove from favourites" : "Add to favourites")"
                        @onclick="ToggleFavoriteAsync" disabled="@_isTogglingFavorite">
                    @(_recipe.IsFavorite ? "★" : "☆")
                </button>
            </div>

            @if (_deleteError is not null)
            {
                <div class="alert alert-danger" role="alert">@_deleteError</div>
            }

            @if (_recipe.Tags.Count > 0)
            {
                <div class="mb-3">
                    @foreach (var tag in _recipe.Tags)
                    {
                        <span class="badge rounded-pill text-bg-secondary me-1 mb-1">
                            @tag.Name
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem"
                                    aria-label="@($"Remove tag {tag.Name}")" @onclick="() => RemoveTagAsync(tag.Id)"></button>
                        </span>
                    }
                </div>
            }

            <div class="mb-3 position-relative" style="max-width: 20rem">
                <label for="tag-input" class="form-label">Add Tag</label>
                <div class="d-flex gap-2">
                    <input id="tag-input" class="form-control" maxlength="50" placeholder="e.g. vegetarian"
                           @bind="_newTag" @bind:event="oninput" @onfocus="() => _showSuggestions = true" />
                    <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="AddTagAsync" disabled="@_isAddingTag">Add Tag</button>
                </div>
                @if (_showSuggestions && TagSuggestions.Count > 0)
                {
                    <ul class="list-group position-absolute w-100 shadow-sm" style="z-index: 10;">
                        @foreach (var suggestion in TagSuggestions)
                        {
                            <li class="list-group-item list-group-item-action" style="cursor: pointer"
                                @onclick="() => SelectSuggestion(suggestion)">
                                @suggestion
                            </li>
                        }
                    </ul>
                }
                @if (_tagError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@_tagError</p>
                }
            </div>

            <div class="mb-3">
                <label for="servings-slider" class="form-label">Servings: @_selectedServings</label>
                <input id="servings-slider" type="range" class="form-range" min="1" max="@_maxServings"
                       @bind="_selectedServings" @bind:event="oninput" style="max-width: 20rem" />
            </div>

            @if (_cookConfirmation is not null)
            {
                <div class="alert alert-success" role="alert">@_cookConfirmation</div>
            }

            @if (_favoriteError is not null)
            {
                <div class="alert alert-danger" role="alert">@_favoriteError</div>
            }

            @if (_cookFrequency is not null)
            {
                <p class="text-muted">@FormatCookFrequency(_cookFrequency)</p>
            }

            <details class="mb-4">
                <summary class="h5" style="cursor: pointer">Cook History</summary>
                @if (_cookHistory is null || _cookHistory.TotalCount == 0)
                {
                    <p class="text-muted">Never cooked — start cooking to begin tracking</p>
                }
                else
                {
                    <p class="text-muted">
                        Cooked @_cookHistory.TotalCount @(_cookHistory.TotalCount == 1 ? "time" : "times") total
                        · @_cookHistory.CountThisMonth this month · @_cookHistory.CountThisWeek this week
                    </p>
                    <ul class="list-group" style="max-height: 18rem; overflow-y: auto;">
                        @foreach (var entry in _cookHistory.Entries)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@RelativeTimeFormatter.FormatLastCooked(entry.CookedAt)</span>
                                <span class="text-muted">@entry.Servings servings</span>
                            </li>
                        }
                    </ul>
                }
            </details>

            <div class="d-flex gap-2 mb-4">
                <button type="button" class="btn btn-primary" disabled title="Coming soon">Start Cooking</button>
                <button type="button" class="btn btn-outline-primary" @onclick="MarkAsCookedAsync" disabled="@_isMarkingCooked">
                    @(_isMarkingCooked ? "Recording..." : "Mark as Cooked")
                </button>
                <a class="btn btn-outline-secondary" href="@($"recipes/{Id}/edit")">Edit Recipe</a>
                <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@_isDeleting">
                    @(_isDeleting ? "Deleting..." : "Delete Recipe")
                </button>
            </div>

            <h2>Ingredients</h2>
            <ul class="list-unstyled">
                @foreach (var ingredient in _recipe.Ingredients)
                {
                    <li>@FormatIngredient(ingredient)</li>
                }
            </ul>

            <h2>Steps</h2>
            @if (_recipe.Steps.Count == 0)
            {
                <p class="text-muted">No steps added.</p>
            }
            else
            {
                <ol>
                    @foreach (var step in _recipe.Steps)
                    {
                        <li class="mb-2">@step.Text</li>
                    }
                </ol>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Recipe? _recipe;
    private bool _notFound;
    private int _selectedServings;
    private int _maxServings = 20;
    private bool _isDeleting;
    private string? _deleteError;
    private bool _isTogglingFavorite;
    private string? _favoriteError;
    private CookFrequency? _cookFrequency;
    private CookHistorySummary? _cookHistory;

    private string _newTag = string.Empty;
    private bool _isAddingTag;
    private string? _tagError;
    private bool _showSuggestions;
    private IReadOnlyList<string> _allTagNames = [];

    private bool _isMarkingCooked;
    private string? _cookConfirmation;

    private IReadOnlyList<string> TagSuggestions =>
        string.IsNullOrWhiteSpace(_newTag)
            ? []
            : _allTagNames
                .Where(name => name.Contains(_newTag.Trim(), StringComparison.OrdinalIgnoreCase)
                    && !_recipe!.Tags.Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
                .Take(5)
                .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _recipe = await RecipeService.GetByIdAsync(Id);
        _notFound = _recipe is null;

        if (_recipe is not null)
        {
            _selectedServings = _recipe.Servings;
            _maxServings = Math.Max(20, _recipe.Servings);
            _allTagNames = await TagService.GetAllTagNamesAsync();
            _cookFrequency = await CookLogService.GetFrequencyAsync(Id);
            _cookHistory = await CookLogService.GetHistoryAsync(Id);
        }
    }

    private static string FormatCookFrequency(CookFrequency frequency)
    {
        if (frequency.TotalCount == 0)
        {
            return "Never cooked";
        }

        var timesWord = frequency.TotalCount == 1 ? "time" : "times";
        var lastCooked = RelativeTimeFormatter.FormatLastCooked(frequency.LastCookedAt);
        return $"Cooked {frequency.TotalCount} {timesWord} · Last cooked {lastCooked}";
    }

    private string FormatIngredient(Ingredient ingredient) =>
        IngredientFormatter.FormatLine(ingredient, _recipe!.Servings, _selectedServings);

    private async Task ToggleFavoriteAsync()
    {
        _isTogglingFavorite = true;
        _favoriteError = null;
        try
        {
            var newState = await RecipeService.ToggleFavoriteAsync(Id);
            if (newState is not null)
            {
                _recipe!.IsFavorite = newState.Value;
            }
            else
            {
                _favoriteError = "Recipe no longer exists.";
            }
        }
        finally
        {
            _isTogglingFavorite = false;
        }
    }

    private async Task AddTagAsync()
    {
        _tagError = null;
        _showSuggestions = false;
        var name = _newTag.Trim();
        if (name.Length == 0)
        {
            return;
        }

        _isAddingTag = true;
        try
        {
            var result = await TagService.AddTagAsync(Id, name);
            if (result is null)
            {
                _tagError = "Recipe no longer exists.";
                return;
            }

            if (!result.Succeeded)
            {
                _tagError = result.Errors.FirstOrDefault() ?? "Failed to add tag.";
                return;
            }

            _recipe = await RecipeService.GetByIdAsync(Id);
            if (_recipe is null)
            {
                _notFound = true;
                return;
            }

            _allTagNames = await TagService.GetAllTagNamesAsync();
            _newTag = string.Empty;
        }
        finally
        {
            _isAddingTag = false;
        }
    }

    private void SelectSuggestion(string suggestion)
    {
        _newTag = suggestion;
        _showSuggestions = false;
    }

    private async Task RemoveTagAsync(Guid tagId)
    {
        _tagError = null;
        var removed = await TagService.RemoveTagAsync(Id, tagId);
        if (!removed)
        {
            _tagError = "That tag was already removed.";
            _recipe = await RecipeService.GetByIdAsync(Id);
            if (_recipe is null)
            {
                _notFound = true;
            }

            return;
        }

        _recipe!.Tags.RemoveAll(t => t.Id == tagId);
        _allTagNames = await TagService.GetAllTagNamesAsync();
    }

    private async Task MarkAsCookedAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "recipeApp.confirmLeave", "Mark this recipe as cooked?");
        if (!confirmed)
        {
            return;
        }

        _isMarkingCooked = true;
        _cookConfirmation = null;
        try
        {
            var entry = await CookLogService.RecordCookAsync(Id, _selectedServings);
            _cookConfirmation = entry is not null
                ? "Marked as cooked. Enjoy!"
                : "Could not record cook — recipe no longer exists.";

            if (entry is not null)
            {
                _cookFrequency = await CookLogService.GetFrequencyAsync(Id);
                _cookHistory = await CookLogService.GetHistoryAsync(Id);
            }
        }
        finally
        {
            _isMarkingCooked = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "recipeApp.confirmLeave", "Are you sure? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _deleteError = null;
        try
        {
            await RecipeService.DeleteAsync(Id);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception)
        {
            _deleteError = "Failed to delete recipe. Please try again.";
            _isDeleting = false;
        }
    }
}
