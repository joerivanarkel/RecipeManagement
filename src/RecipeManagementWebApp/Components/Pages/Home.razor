@page "/"
@rendermode InteractiveServer
@using RecipeManagementWebApp.Services
@inject IRecipeService RecipeService

<PageTitle>Recipes</PageTitle>

<h1>Recipes</h1>

@if (_recipes is null)
{
    <p>Loading...</p>
}
else if (_recipes.Count == 0)
{
    <div class="text-center py-5">
        <p class="fs-5">No recipes yet</p>
        <a class="btn btn-primary" href="recipes/add">Add your first recipe</a>
    </div>
}
else
{
    <div class="mb-3" style="max-width: 24rem">
        <label for="searchBox" class="form-label visually-hidden">Search recipes</label>
        <input id="searchBox" class="form-control" placeholder="Search by title or ingredient..."
               @bind="_searchQuery" @bind:event="oninput" />
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="favouritesOnlyToggle" @bind="_favouritesOnly" />
        <label class="form-check-label" for="favouritesOnlyToggle">Favourites only</label>
    </div>

    @if (!string.IsNullOrWhiteSpace(_searchQuery) && _visibleRecipes.Count == 0)
    {
        <div class="text-center py-5">
            <p class="fs-5">No recipes found for '@_searchQuery.Trim()'</p>
        </div>
    }
    else if (_favouritesOnly && _visibleRecipes.Count == 0)
    {
        <div class="text-center py-5">
            <p class="fs-5">No favourites yet — tap the star on a recipe to add one</p>
        </div>
    }
    else
    {
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var recipe in _visibleRecipes)
        {
            var (visibleTags, moreCount) = SplitTags(recipe.Tags);
            <div class="col position-relative">
                <button type="button"
                        class="recipe-card-favorite btn btn-link p-0 border-0 @(recipe.IsFavorite ? "text-warning" : "text-white")"
                        title="@(recipe.IsFavorite ? "Unfavourite" : "Favourite")"
                        aria-label="@(recipe.IsFavorite ? "Remove from favourites" : "Add to favourites")"
                        @onclick="() => ToggleFavoriteAsync(recipe.Id)">
                    @(recipe.IsFavorite ? "★" : "☆")
                </button>
                <a class="recipe-card card h-100 text-decoration-none text-reset" href="@($"recipes/{recipe.Id}")">
                    @if (recipe.PhotoUrl is not null)
                    {
                        <img src="@recipe.PhotoUrl" class="card-img-top recipe-card-photo" alt="@recipe.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="recipe-card-photo recipe-card-placeholder d-flex align-items-center justify-content-center">
                            <span>No Photo</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title text-truncate">@recipe.Title</h5>
                        <p class="text-muted small mb-0">@RelativeTimeFormatter.FormatLastCooked(recipe.LastCookedAt)</p>
                        @if (visibleTags.Count > 0)
                        {
                            <div class="mt-2">
                                @foreach (var tag in visibleTags)
                                {
                                    <span class="badge rounded-pill text-bg-secondary me-1">@tag</span>
                                }
                                @if (moreCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-light border">+@moreCount more</span>
                                }
                            </div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
    }
}

@code {
    private const int MaxVisibleTags = 5;

    private IReadOnlyList<RecipeSummary>? _recipes;
    private bool _favouritesOnly;
    private string _searchQuery = string.Empty;

    private IReadOnlyList<RecipeSummary> _visibleRecipes
    {
        get
        {
            IEnumerable<RecipeSummary> recipes = _recipes!;

            if (_favouritesOnly)
            {
                recipes = recipes.Where(r => r.IsFavorite);
            }

            var query = _searchQuery.Trim();
            if (query.Length > 0)
            {
                recipes = recipes.Where(r =>
                    r.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || r.IngredientNames.Any(i => i.Contains(query, StringComparison.OrdinalIgnoreCase)));
            }

            return recipes.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _recipes = await RecipeService.GetSummariesAsync();
    }

    private async Task ToggleFavoriteAsync(Guid recipeId)
    {
        var newState = await RecipeService.ToggleFavoriteAsync(recipeId);
        if (newState is null || _recipes is null)
        {
            return;
        }

        _recipes = _recipes
            .Select(r => r.Id == recipeId ? r with { IsFavorite = newState.Value } : r)
            .ToList();
    }

    private static (IReadOnlyList<string> Visible, int MoreCount) SplitTags(IReadOnlyList<string> tags)
    {
        if (tags.Count <= MaxVisibleTags)
        {
            return (tags, 0);
        }

        return (tags.Take(MaxVisibleTags).ToList(), tags.Count - MaxVisibleTags);
    }
}
